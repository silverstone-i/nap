# Copy to .env and adjust for your machine. Never commit .env.
# Every variable read by the committed code appears here; new variables must
# be added with a safe default in the same change (RULES/api-server.md).

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database — server startup resolves the URL matching NODE_ENV
DATABASE_URL_DEV=postgres://nap_admin:change-me@localhost:5432/nap_dev
DATABASE_URL_TEST=postgres://nap_admin:change-me@localhost:5432/nap_test
DATABASE_URL_PROD=

# Auth — access-token signing and cookie flags (RULES/auth-module.md).
# The secret has no in-code fallback; generate one: openssl rand -hex 32
ACCESS_TOKEN_SECRET=change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis — permission canon and active-tenant cache (ADR-0012). Optional:
# unset means fail-open, the canon rebuilds from Postgres on every request.
# REDIS_URL_TEST gates the canon integration tests (skipped when unset).
REDIS_URL=
REDIS_URL_TEST=

# argon2id parameters — OWASP baseline defaults; values may be raised, never
# lowered (ADR-0015). Read by the server and db:bootstrap.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Root tenant and platform admin — read by db:bootstrap only. The schema name
# is the tenant code lowercased (NAP -> nap).
ROOT_TENANT_CODE=NAP
ROOT_COMPANY=NAP
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=change-me