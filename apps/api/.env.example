# Copy to .env and adjust for your machine. Never commit .env.
# Every variable read by the committed code appears here; new variables must
# be added with a safe default in the same change (RULES/api-server.md).

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database — server startup resolves the URL matching NODE_ENV
DATABASE_URL_DEV=postgres://nap_admin:change-me@localhost:5432/nap_dev
DATABASE_URL_TEST=postgres://nap_admin:change-me@localhost:5432/nap_test
DATABASE_URL_PROD=
