# Copy to .env. Never commit actual secrets.
# Inherited environment variables take precedence.
# NODE_ENV selects DEV, TEST, or PROD.
# Generate each new database-role password independently: openssl rand -hex 32
# Password generation/rotation is separate from configuration conversion.

# ============================================================
# 1. DEVELOPMENT
# ============================================================

# nap-admin: setup and migrations, with LOGIN, CREATEDB and CREATEROLE.
# nap-app: application runtime with minimal privileges.
# Each role shares its password across databases on the local instance.
NAP_APP_PSWD_DEV=<development-app-password>
NAP_ADMIN_PSWD_DEV=<development-admin-password>

# Endpoints exclude credentials and the postgres:// prefix.
ADMIN_DATABASE_DEV=localhost:5432/nap_dev_admin
# Existing maintenance database; setup connects as nap-admin with NAP_ADMIN_PSWD_DEV.
SETUP_DATABASE_DEV=localhost:5432/postgres

# Empty until cells are registered. Use their actual registered UUIDs.
CELL_DATABASES_DEV={}
# Example shape only:
# CELL_DATABASES_DEV={"00000000-0000-4000-8000-000000000001":"localhost:5432/nap_dev_cell_1","00000000-0000-4000-8000-000000000002":"localhost:5432/nap_dev_cell_2"}

# Generate session and throttle secrets independently (at least 32 characters).
SESSION_SECRET_DEV=<development-session-secret>
AUTH_THROTTLE_SECRET_DEV=<development-throttle-secret>

ROOT_TENANT_CODE_DEV=NAP
ROOT_COMPANY_DEV=NAP
ROOT_EMAIL_DEV=root@example.com
# Root password: 12–128 characters, no placeholder values.
ROOT_PASSWORD_DEV=<development-root-password>

COOKIE_SECURE_DEV=false
# Session cookies accept lax or strict only; SameSite=None is rejected.
COOKIE_SAMESITE_DEV=lax
TRUST_PROXY_HOPS_DEV=0
# Browser-facing origin that may change state. In development this is the Vite
# dev server, which proxies /api, not the API's own port.
APP_ORIGIN_DEV=http://localhost:5173

REDIS_URL_DEV=
REDIS_CACHE_ENABLED_DEV=false
REDIS_CACHE_NAMESPACE_DEV=nap_dev

# ------------------------------------------------------------
# TEST — isolated credentials and database targets
# Separate instance required when fixed-role passwords differ from DEV.
# ------------------------------------------------------------

NAP_APP_PSWD_TEST=<test-app-password>
NAP_ADMIN_PSWD_TEST=<test-admin-password>
ADMIN_DATABASE_TEST=localhost:5432/nap_test_admin
SETUP_DATABASE_TEST=localhost:5432/postgres
CELL_DATABASES_TEST={}

SESSION_SECRET_TEST=<test-session-secret>
AUTH_THROTTLE_SECRET_TEST=<test-throttle-secret>
ROOT_TENANT_CODE_TEST=NAP
ROOT_COMPANY_TEST=NAP
ROOT_EMAIL_TEST=root@nap.test
ROOT_PASSWORD_TEST=<test-root-password>

COOKIE_SECURE_TEST=false
COOKIE_SAMESITE_TEST=lax
TRUST_PROXY_HOPS_TEST=0
APP_ORIGIN_TEST=http://localhost:5173
REDIS_URL_TEST=
REDIS_CACHE_ENABLED_TEST=false
REDIS_CACHE_NAMESPACE_TEST=nap_test

# ============================================================
# 2. PRODUCTION
# ============================================================

# Each independently hosted database has its own two passwords.
# nap-admin: setup and migrations, with LOGIN, CREATEDB and CREATEROLE.
# nap-app: application runtime with minimal privileges.
# Supply actual values through deployment-owned configuration.
# Requested production admin database name; choose before first setup and retain for retries.
ADMIN_DATABASE_NAME_PROD=nap_prod_admin
ADMIN_DATABASE_PROD=
# Optional resolved maintenance endpoint; new Render setup discovers it from the provider.
SETUP_DATABASE_PROD=
CELL_DATABASES_PROD={}
# Admin entry shape:
# ADMIN_DATABASE_PROD={"endpoint":"admin-host:5432/nap_prod_admin?sslmode=require","appPassword":"<unique-app-password>","adminPassword":"<unique-admin-password>"}
# Cell entry shape; substitute the actual registered UUID:
# CELL_DATABASES_PROD={"00000000-0000-4000-8000-000000000001":{"endpoint":"cell-host:5432/nap_prod_cell_east?sslmode=require","appPassword":"<unique-app-password>","adminPassword":"<unique-admin-password>"}}
# Provisioning uses adminPassword on the server; browsers never receive credentials.
# Maintenance execution: supply the selected database's adminPassword.
# Runtime does not require migration credentials.
# Supported endpoint options: sslmode, sslcert, sslkey, sslrootcert, application_name.
# Render provisioning uses provider credentials on the API server; clients never receive them.

# Infrastructure settings: the local PROD admin maintenance CLI reads nonsecret defaults
# from render.yaml. Nonblank shell values override .env, then Blueprint values.
# Keep RENDER_API_KEY and RENDER_API_SERVICE_ID private; both are required locally.
# The API service receives Blueprint settings through Render, not this CLI fallback.
# This foundation CLI stores recovery locally in .env.provisioning.prod.json (mode 0600).
# NAP_PROVISION_STATE_PROD below is reserved for the later API cell runner.
NAP_PROVISION_STATE_PROD=
RENDER_API_KEY=
RENDER_WORKSPACE_ID=
RENDER_REGION=
RENDER_POSTGRES_VERSION=18
RENDER_POSTGRES_PLAN=
RENDER_DISK_GB=
RENDER_API_SERVICE_ID=

SESSION_SECRET_PROD=
AUTH_THROTTLE_SECRET_PROD=
ROOT_TENANT_CODE_PROD=NAP
ROOT_COMPANY_PROD=NAP
ROOT_EMAIL_PROD=
ROOT_PASSWORD_PROD=
# Production requires Secure cookies and an https application origin.
COOKIE_SECURE_PROD=true
COOKIE_SAMESITE_PROD=lax
APP_ORIGIN_PROD=
# Set to the actual trusted proxy count (0–16) before production startup.
TRUST_PROXY_HOPS_PROD=
REDIS_URL_PROD=
REDIS_CACHE_ENABLED_PROD=true
REDIS_CACHE_NAMESPACE_PROD=nap_prod

# ============================================================
# 3. COMMON
# ============================================================

NODE_ENV=development
# Render can supply PORT through the process environment.
PORT=3000
LOG_LEVEL=info
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Argon2id floors, shared by every environment. Startup refuses a lower value.
# Raising one rehashes each account's password on its next successful login.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# CLI-only optional path overrides. Defaults resolve relative to the repository.
# NAP_ENV_FILE=/absolute/path/to/private.env
# NAP_PROVISION_STATE=/absolute/path/to/private-provisioning-state.json
# State holds credentials and resumable infrastructure intent; back it up privately.
