# PORT, database setup, authentication, sessions, cookies, and root bootstrap are implemented.
# Redis and cell deployment settings remain proposed.
# Names and sample values below are planning inputs, not an implemented contract.
# Confirm defaults and validation with each capability's design and implementation.
# Copy to .env and adjust for your machine. Inherited environment takes precedence. Never commit .env.
# Every variable read by committed code must appear here with a safe sample value.

# Environment
NODE_ENV=development
# Local HTTP port: integer 1–65535, default 3000.
PORT=3000
# Proposed logging level; the specification technology stack owns logging.
LOG_LEVEL=info

# Database topology and role separation are owned by the platform specification:
# docs/specs/nap-platform-specification.md#database-composition-roots
# and ARCH-004, ARCH-008, ARCH-019, ARCH-024, ARCH-025, and ARCH-026.
# Runtime uses NODE_ENV (development by default) to select DEV/TEST/PROD URLs.
# Runtime requires both DATABASE URLs only; migrate requires its selected MIGRATION URL only.
# PostgreSQL URLs preserve sslmode/sslcert/sslkey/sslrootcert/application_name options.
# Other query options are rejected; setup retains its stricter option-free URL contract.
# Connections time out after five seconds. Never run the API with migration credentials.
ADMIN_DATABASE_URL_DEV=postgres://nap_app:change-me@localhost:5432/nap_admin_dev
ADMIN_DATABASE_URL_TEST=postgres://nap_app:change-me@localhost:5432/nap_admin_test
ADMIN_DATABASE_URL_PROD=
ADMIN_MIGRATION_URL_DEV=postgres://nap_admin:change-me@localhost:5432/nap_admin_dev
ADMIN_MIGRATION_URL_TEST=postgres://nap_admin:change-me@localhost:5432/nap_admin_test
ADMIN_MIGRATION_URL_PROD=

CELL_DATABASE_URL_DEV=postgres://nap_app:change-me@localhost:5432/nap_cell_dev
CELL_DATABASE_URL_TEST=postgres://nap_app:change-me@localhost:5432/nap_cell_test
CELL_DATABASE_URL_PROD=
CELL_MIGRATION_URL_DEV=postgres://nap_admin:change-me@localhost:5432/nap_cell_dev
CELL_MIGRATION_URL_TEST=postgres://nap_admin:change-me@localhost:5432/nap_cell_test
CELL_MIGRATION_URL_PROD=

# Admin migrations grant this non-owner role authentication table access.
# The cell grant setting remains proposed for cell-owned production tables.
ADMIN_RUNTIME_ROLE=nap_app
CELL_RUNTIME_ROLE=nap_app

# Deployment-specific cell identifier; populate for the configured cell.
CELL_ID=

# Development/test setup connections: same server and owner credentials as migration URLs.
SETUP_ADMIN_URL_DEV=postgres://nap_admin:change-me@localhost:5432/postgres
SETUP_ADMIN_URL_TEST=postgres://nap_admin:change-me@localhost:5432/postgres

# Trusted reverse-proxy hops in front of the API, a whole number from 0 to 16.
# With 0 the socket address is the client address and X-Forwarded-For is
# ignored; set the real hop count for the deployment (PRD 0003, AUTH-005).
TRUST_PROXY_HOPS=0

# Authentication (PRD 0003). Both secrets require at least 32 characters and
# must not be placeholders; generate each independently with openssl rand -hex 32.
# Idle minutes: 1–1440; absolute hours: 1–8760.
SESSION_SECRET=change-me
AUTH_THROTTLE_SECRET=change-me
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# The specification deployment topology owns the shared web and /api origin.
# Cookies are HttpOnly and secure by default. This local sample disables Secure.
# SameSite accepts lax (default), strict, or none; none requires Secure.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis connection placeholders for the cache capability under ARCH-029:
# docs/specs/nap-platform-specification.md#arch-029--redis-accelerates-postgresql-decides
# Prove authentication and authorization against PostgreSQL first, then add
# Redis to reduce repeated session, routing, and authorization database lookups.
# Redis remains part of managed deployment; cache misses or outages use the
# PostgreSQL-backed path without changing access decisions.
REDIS_URL=
REDIS_URL_TEST=

# Argon2id: memory 19456–1048576 KiB, time cost 2–20, parallelism 1–16.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Root bootstrap inputs. Password: 12–128 characters, no placeholders.
# After db:migrate:admin, run npm run db:bootstrap. Existing passwords are untouched.
# Recovery: npm run db:bootstrap -- --reset-root-password (revokes root sessions).
ROOT_TENANT_CODE=NAP
ROOT_COMPANY=NAP
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=change-me
