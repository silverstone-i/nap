# Copy to .env and adjust for your machine. Never commit .env.
# Every variable read by the committed code appears here; new variables must
# be added with a safe default in the same change.

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Databases (ADR 0004) — one central administration database and one database
# per cell. The suffix matching NODE_ENV is the one that is read.
#
# *_DATABASE_URL_* carries the least-privileged runtime role used to handle
# requests. *_MIGRATION_URL_* carries the owning role and is read only by the
# release migration commands (npm run db:migrate:admin / db:migrate:cell).
ADMIN_DATABASE_URL_DEV=postgres://nap_app:change-me@localhost:5432/nap_admin_dev
ADMIN_DATABASE_URL_TEST=postgres://nap_app:change-me@localhost:5432/nap_admin_test
ADMIN_DATABASE_URL_PROD=
ADMIN_MIGRATION_URL_DEV=postgres://nap_admin:change-me@localhost:5432/nap_admin_dev
ADMIN_MIGRATION_URL_TEST=postgres://nap_admin:change-me@localhost:5432/nap_admin_test
ADMIN_MIGRATION_URL_PROD=

CELL_DATABASE_URL_DEV=postgres://nap_app:change-me@localhost:5432/nap_cell_dev
CELL_DATABASE_URL_TEST=postgres://nap_app:change-me@localhost:5432/nap_cell_test
CELL_DATABASE_URL_PROD=
CELL_MIGRATION_URL_DEV=postgres://nap_admin:change-me@localhost:5432/nap_cell_dev
CELL_MIGRATION_URL_TEST=postgres://nap_admin:change-me@localhost:5432/nap_cell_test
CELL_MIGRATION_URL_PROD=

# The role migrations grant table privileges to. It must not own tables and
# must not hold SUPERUSER or BYPASSRLS; startup refuses to run if it does.
ADMIN_RUNTIME_ROLE=nap_app
CELL_RUNTIME_ROLE=nap_app

# Logical identifier of the cell this deployment serves. Never appears in a
# customer URL or client API contract (ARCH-007).
CELL_ID=cell-001

# Superuser or CREATEDB connection used only by npm run db:setup:dev and
# db:setup:test to create the local databases and the runtime role.
SETUP_ADMIN_URL_DEV=postgres://nap_admin:change-me@localhost:5432/postgres
SETUP_ADMIN_URL_TEST=postgres://nap_admin:change-me@localhost:5432/postgres

# Auth — access-token signing and cookie flags.
# The secret has no in-code fallback; generate one: openssl rand -hex 32
ACCESS_TOKEN_SECRET=change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis — permission canon and active-tenant cache. Optional:
# unset means fail-open, the canon rebuilds from Postgres on every request.
# REDIS_URL_TEST gates the canon integration tests (skipped when unset).
REDIS_URL=
REDIS_URL_TEST=

# argon2id parameters — OWASP baseline defaults; values may be raised, never
# lowered. Read by the server and db:bootstrap.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Root tenant and platform admin — read by db:bootstrap only. Provisioning
# creates records, not schemas: every tenant shares the cell's tables.
ROOT_TENANT_CODE=NAP
ROOT_COMPANY=NAP
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=change-me
