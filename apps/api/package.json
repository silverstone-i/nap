{
  "name": "@nap/api",
  "version": "0.1.0",
  "description": "NAP API server",
  "scripts": {
    "dev": "concurrently -k \"tsc --watch --project tsconfig.build.json\" \"node --watch --env-file-if-exists=.env dist/server.js\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "db:bootstrap": "node --env-file-if-exists=.env dist/scripts/bootstrap-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "pg-schemata": "^2.0.0",
    "zod": "^3.25.63"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.4",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
